---
import type { Locale } from '../data/i18n';
import { SITE_TEXT, siteAddress } from '../data/site';
import type { Stanza } from '../lib/lyrics';

interface Props {
  titles: string[];
  stanzas: Stanza[];
  /** Language of the footer credit. */
  locale: Locale;
}

const { titles, stanzas, locale } = Astro.props;
---

<!-- Hidden on screen; the only thing that prints. Sized to one A4 page by src/scripts/print.ts; the footer sits at the bottom. -->
<section class="print-sheet" lang="pt-BR" dir="ltr" data-print-sheet>
  <h1 class="print-title">{titles[0]}</h1>
  {titles.length > 1 && <p class="print-aka">{titles.slice(1).join(' · ')}</p>}
  <div class="print-lyrics">
    {
      stanzas.map((stanza) => (
        <div class="print-stanza">
          {stanza.map((line) => (
            <div class:list={['print-line', { coro: line.coro }]}>
              {line.pt}
              {line.repeat && <span class="print-repeat">{` ×${line.repeat}`}</span>}
            </div>
          ))}
        </div>
      ))
    }
  </div>
  <footer class="print-footer">
    <img class="print-icon" src={`${import.meta.env.BASE_URL}favicon.svg`} alt="" width="38" height="38" />
    <div>
      <div class="print-credit" lang={locale} dir="auto">{SITE_TEXT[locale].createdBy}</div>
      <div class="print-url">{siteAddress()}</div>
    </div>
  </footer>
</section>

<script>
  import { setupPrint } from '../scripts/print';
  setupPrint();
</script>
