---
import { LANGUAGES, LOCALES, UI, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  /** Where each language's link goes. */
  links: Record<Locale, string>;
  /** The links are this same page in other languages: carry the search (?q=…) and #anchor over when switching. */
  samePage?: boolean;
}

const { locale, links, samePage = false } = Astro.props;
---

<details class="lang-menu" data-lang-menu>
  <summary title={UI[locale].language}>
    <svg class="globe" viewBox="0 0 24 24" aria-hidden="true"
      ><g fill="none" stroke="currentColor" stroke-width="2"
        ><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"
        ></path></g
      ></svg
    >
    <span class="sr-only">{UI[locale].language}:</span>
    <span lang={locale}>{LANGUAGES[locale].label}</span>
    <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"
      ><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
      ></path></svg
    >
  </summary>
  <ul class="lang-list">
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={links[l]}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'true' : undefined}
            data-lang={l}
            data-same-page={samePage || undefined}
          >
            {LANGUAGES[l].label}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  /** Remembered so that opening the site later (bookmark, home-screen app) lands in this language; see Base.astro. */
  const STORAGE_KEY = 'lang';

  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu]')) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
    for (const link of menu.querySelectorAll<HTMLAnchorElement>('a[data-lang]')) {
      link.addEventListener('click', () => {
        try {
          localStorage.setItem(STORAGE_KEY, link.dataset.lang!);
        } catch {}
        if (link.dataset.samePage) link.href = link.href.split(/[?#]/)[0] + location.search + location.hash;
      });
    }
  }
</script>

<style>
  .lang-menu {
    position: relative;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 5px 12px;
    font-weight: 600;
    list-style: none;
    background: var(--paper);
    border: var(--border);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    user-select: none;
    transition:
      translate 0.12s ease,
      box-shadow 0.12s ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    translate: -1px -1px;
    box-shadow: 4px 4px 0 var(--ink);
  }

  summary svg {
    width: 1.1em;
    height: 1.1em;
    flex: none;
  }

  .chevron {
    transition: rotate 0.15s ease;
  }

  .lang-menu[open] .chevron {
    rotate: 180deg;
  }

  .lang-list {
    position: absolute;
    top: calc(100% + 8px);
    inset-inline-end: 0;
    z-index: 20;
    min-width: 100%;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  .lang-list a {
    display: block;
    padding: 5px 14px;
    font-weight: 600;
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 8px;
  }

  .lang-list a:hover {
    background: color-mix(in srgb, var(--yellow) 40%, transparent);
  }

  .lang-list a[aria-current] {
    background: var(--yellow);
  }
</style>
