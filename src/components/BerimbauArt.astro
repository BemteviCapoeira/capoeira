---
// Stand-in illustration for songs without a photo. `broken` is for "nothing here" moments
// (no search results, page not found, a rejected token): the gourd is cracked and split open.
interface Props {
  broken?: boolean;
}

const { broken = false } = Astro.props;
---

<div class:list={['berimbau-art', { broken }]} aria-hidden="true">
  <svg viewBox="0 0 80 120">
    <path d="M52 6Q24 60 52 114" fill="none" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"></path>
    <path d="M52 6V114" stroke="var(--ink)" stroke-width="1.6"></path>
    <path d="M41 84H52" stroke="var(--ink)" stroke-width="2.4"></path>
    {
      broken ? (
        <>
          {/* dark inside of the gourd, showing through the gap */}
          <path d="M27 99.86L31 72.14 21.3 72.4Z" fill="#5a2e0e" />
          {/* right half stays tied to the bow */}
          <path
            d="M31 72.14A14 14 0 0 1 27 99.86L28 95 31 91 27 86 32 81 28 77Z"
            fill="var(--orange)"
            stroke="var(--ink)"
            stroke-width="3"
            stroke-linejoin="round"
          />
          {/* left half has cracked off and tilts open from the bottom */}
          <g transform="rotate(-20 27 99.86)">
            <path
              d="M31 72.14A14 14 0 0 0 27 99.86L28 95 31 91 27 86 32 81 28 77Z"
              fill="var(--orange)"
              stroke="var(--ink)"
              stroke-width="3"
              stroke-linejoin="round"
            />
            <path d="M21 80a9 9 0 0 1 6-4.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity=".7" />
          </g>
        </>
      ) : (
        <>
          <circle cx="29" cy="86" r="14" fill="var(--orange)" stroke="var(--ink)" stroke-width="3" />
          <path d="M21 80a9 9 0 0 1 9-5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity=".7" />
        </>
      )
    }
  </svg>
</div>

<style>
  .berimbau-art {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    background:
      repeating-linear-gradient(
        -45deg,
        color-mix(in srgb, var(--paper) 50%, transparent) 0 12px,
        transparent 12px 24px
      ),
      color-mix(in srgb, var(--accent, var(--yellow)) 55%, var(--paper));
  }

  svg {
    height: 72%;
    width: auto;
    rotate: -18deg;
  }

  .broken svg {
    height: 82%;
  }
</style>
