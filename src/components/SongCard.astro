---
import { Image } from 'astro:assets';
import { TAGS } from '../data/tags';
import { firstLine } from '../lib/lyrics';
import { songUrl, type Song } from '../lib/songs';
import { fold } from '../lib/text';
import BerimbauArt from './BerimbauArt.astro';

interface Props {
  song: Song;
  accent: string;
}

const { song, accent } = Astro.props;
const { titles, tags, image, youtube, lyrics, translation } = song.data;
const opening = firstLine(lyrics);
const showOpening = opening && !titles.some((t) => fold(t) === fold(opening));
---

<a class="song-card" href={songUrl(song)} style={`--accent:${accent}`}>
  <div class="media">
    {
      image ? (
        <Image src={image} alt="" widths={[320, 560]} sizes="(min-width: 720px) 300px, 92vw" />
      ) : (
        <BerimbauArt />
      )
    }
  </div>
  <div class="body">
    <h3 class="pt-text" lang="pt-BR">{titles[0]}</h3>
    {titles.length > 1 && <p class="aka pt-text" lang="pt-BR">{titles.slice(1).join(' · ')}</p>}
    {showOpening && <p class="opening pt-text" lang="pt-BR">“{opening}”</p>}
    <div class="meta">
      {
        tags.map((tag) => (
          <span class="mini-chip" style={`--chip:var(--${TAGS[tag].color})`} lang="pt-BR">
            {TAGS[tag].label}
          </span>
        ))
      }
      {youtube && <span class="badge" title="יש ביצוע ביוטיוב">▶ וידאו</span>}
      {translation && <span class="badge" title="יש תרגום לעברית">תרגום</span>}
    </div>
  </div>
</a>

<style>
  .song-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
    background: var(--accent);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition:
      translate 0.15s ease,
      rotate 0.15s ease,
      box-shadow 0.15s ease;
  }

  .song-card:hover {
    translate: 2px -3px;
    rotate: -0.6deg;
    box-shadow: -9px 9px 0 var(--ink);
  }

  .song-card:focus-visible {
    outline-offset: 4px;
  }

  .media {
    aspect-ratio: 4 / 3;
    border-bottom: var(--border);
    background: var(--paper);
    overflow: hidden;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    padding: 14px 18px 16px;
  }

  h3 {
    font-size: 1.4rem;
  }

  .aka,
  .opening {
    margin: 0;
    font-size: 0.95rem;
  }

  .opening {
    font-style: italic;
    opacity: 0.8;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 10px;
  }

  .mini-chip,
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 1px 10px;
    font-size: 0.82rem;
    font-weight: 600;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 999px;
  }

  /* phones: compact rows (thumbnail beside the title) so the list stays scannable */
  @media (max-width: 560px) {
    .song-card {
      flex-direction: row;
      box-shadow: var(--shadow-sm);
    }

    .media {
      flex: none;
      width: 104px;
      aspect-ratio: auto;
      border-bottom: 0;
      border-inline-end: var(--border);
    }

    .media :global(.berimbau-art) {
      aspect-ratio: auto;
    }

    .body {
      padding: 10px 14px 12px;
    }

    h3 {
      font-size: 1.2rem;
    }

    .aka,
    .opening {
      font-size: 0.88rem;
    }

    .meta {
      padding-top: 6px;
    }
  }

  .mini-chip::before {
    content: '';
    width: 0.65em;
    height: 0.65em;
    border-radius: 50%;
    background: var(--chip);
    border: 1.5px solid var(--ink);
  }
</style>
