---
import { getImage } from 'astro:assets';
import type { Locale } from '../data/i18n';
import { TAGS } from '../data/tags';
import { firstLine } from '../lib/lyrics';
import { songUrl, type Song } from '../lib/songs';
import { getSongImage } from '../lib/song-images';
import { fold } from '../lib/text';

interface Props {
  song: Song;
  locale: Locale;
}

const { song, locale } = Astro.props;
const { titles, tags, lyrics } = song.data;
const image = getSongImage(song.id, song.data.image);
const imageWide = getSongImage(song.id, song.data.imageWide);
const imageTall = getSongImage(song.id, song.data.imageTall);
// Wide crop for the grid, tall crop for the phone layout's thumbnail (see PHONE below).
let wide;
let tall;
const wideSource = imageWide ?? image ?? imageTall;
const tallSource = imageTall ?? image ?? imageWide;
if (wideSource && tallSource) {
  try {
    wide = await getImage({ src: wideSource, widths: [320, 560, 840], format: 'webp' });
    tall = await getImage({ src: tallSource, widths: [104, 208, 312], format: 'webp' });
  } catch {
    wide = undefined;
    tall = undefined;
  }
}
const opening = firstLine(lyrics);
const showOpening = opening && !titles.some((t) => fold(t) === fold(opening));
---

<a class="song-card" href={songUrl(song, locale)}>
  <div class="media">
    {
      wide && tall ? (
        <picture>
          <source media="(max-width: 560px)" srcset={tall.srcSet.attribute} sizes="104px" type="image/webp" />
          <img
            src={wide.src}
            srcset={wide.srcSet.attribute}
            data-image-fallback
            sizes="(min-width: 720px) 300px, 50vw"
            alt=""
            loading="lazy"
            decoding="async"
            width={wide.attributes.width}
            height={wide.attributes.height}
          />
        </picture>
      ) : (
        <img
          src={`${import.meta.env.BASE_URL}logo-blue-bg.svg`}
          alt=""
          class="image-fallback"
          width="300"
          height="225"
          loading="lazy"
        />
      )
    }
  </div>
  <div class="body">
    <h3 class="pt-text" lang="pt-BR">{titles[0]}</h3>
    {titles.length > 1 && <p class="aka pt-text" lang="pt-BR">{titles.slice(1).join(' · ')}</p>}
    {showOpening && <p class="opening pt-text" lang="pt-BR">“{opening}”</p>}
    <div class="meta">
      {
        tags.map((tag) => (
          <span class="mini-chip" style={`--chip:var(--${TAGS[tag].color})`} lang="pt-BR">
            {TAGS[tag].label}
          </span>
        ))
      }
    </div>
  </div>
</a>

<style>
  .song-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition:
      translate 0.15s ease,
      rotate 0.15s ease,
      box-shadow 0.15s ease;
  }

  .song-card:hover {
    translate: -2px -3px;
    rotate: 0.6deg;
    box-shadow: 9px 9px 0 var(--ink);
  }

  .song-card:focus-visible {
    outline-offset: 4px;
  }

  .media {
    aspect-ratio: 4 / 3;
    border-bottom: var(--border);
    overflow: hidden;
  }

  .media picture {
    display: contents;
  }

  /* the crops already have the box's shape; cover handles the phone thumbnail's varying height */
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .media img.image-fallback {
    object-fit: contain;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    padding: 14px 18px 16px;
  }

  h3 {
    font-size: 1.4rem;
  }

  .aka,
  .opening {
    margin: 0;
    font-size: 0.95rem;
  }

  .opening {
    font-style: italic;
    opacity: 0.8;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 10px;
  }

  /* PHONE: compact rows (tall thumbnail beside the title) so the list stays scannable.
     Keep the breakpoint in sync with the <source media> above. */
  @media (max-width: 560px) {
    .song-card {
      flex-direction: row;
      box-shadow: var(--shadow-sm);
    }

    .media {
      flex: none;
      width: 104px;
      aspect-ratio: auto;
      border-bottom: 0;
      border-inline-end: var(--border);
    }

    .media :global(.berimbau-art) {
      aspect-ratio: auto;
    }

    .body {
      padding: 10px 14px 12px;
    }

    h3 {
      font-size: 1.2rem;
    }

    .aka,
    .opening {
      font-size: 0.88rem;
    }

    .meta {
      padding-top: 6px;
    }
  }

</style>
