---
import '@fontsource-variable/rubik';
import '@fontsource-variable/fredoka';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/print.css';
import { Image } from 'astro:assets';
import bemtevi from '../assets/bemtevi.jpg';
import Ribbons from '../components/Ribbons.astro';
import { Content as Welcome } from '../content/home.md';
import { SITE } from '../data/site';

const NAME_COLORS = ['coral', 'turquoise', 'yellow', 'pink', 'lime', 'sky'];

interface Props {
  title?: string;
  description?: string;
  /** Absolute path of a social-preview image. */
  image?: string;
  /** Keep the page out of search engines. */
  noindex?: boolean;
}

const { title, description = SITE.description, image, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.shortTitle}` : SITE.title;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="he" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#ffcf33" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <div class="site">
      <a class="skip-link" href="#main">דלגו לתוכן</a>
      <header class="site-header">
        <div class="wrap">
          <a class="brand" href={base}>
            <Image src={bemtevi} alt="" width={112} class="brand-emblem" loading="eager" />
            <span>{SITE.shortTitle}</span>
          </a>
          <span class="brand-tag" lang="pt-BR">Abadá-Capoeira</span>
        </div>
      </header>
      <Ribbons />
      <main id="main" class="wrap">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="wrap footer-grid" dir="rtl">
          <section class="footer-about">
            <h2 class="footer-title">{SITE.title}</h2>
            <p class="footer-club">{SITE.club}</p>
            <p>{SITE.group}</p>
          </section>
          <section class="footer-letter">
            <Welcome />
            <p class="cheer" lang="pt-BR" dir="ltr">{SITE.cheer}</p>
            <p class="credit">{SITE.credit}</p>
          </section>
          <section class="footer-thanks">
            <h2>תודה!</h2>
            <p>{SITE.thanksIntro}</p>
            <ul class="names">
              {SITE.thanks.map((name, i) => <li style={`--c:var(--${NAME_COLORS[i % NAME_COLORS.length]})`}>{name}</li>)}
            </ul>
          </section>
        </div>
        <div class="wrap footer-links">
          <a href={`${base}new-song/`}>+ Add a song</a>
        </div>
      </footer>
    </div>
    <slot name="print" />
  </body>
</html>

<style>
  .site {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .site-header {
    background: var(--yellow);
    border-bottom: var(--border);
  }

  .site-header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.4rem;
  }

  .brand-emblem {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: var(--border);
    object-fit: cover;
    object-position: 50% 30%;
    box-shadow: var(--shadow-sm);
    transition: rotate 0.3s ease;
  }

  .brand:hover .brand-emblem {
    rotate: -12deg;
  }

  .brand-tag {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  main {
    flex: 1;
    padding-block: 20px 72px;
  }

  .site-footer {
    padding-block: 40px 24px;
    color: var(--sand);
    background: var(--ink);
    border-top: 6px solid var(--coral);
    box-shadow: 0 -6px 0 var(--turquoise);
  }

  .footer-grid {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1.6fr 1fr;
      align-items: start;
    }
  }

  .site-footer h2 {
    margin-bottom: 10px;
    font-size: 1.5rem;
    color: var(--yellow);
  }

  .footer-title {
    font-size: clamp(1.6rem, 4vw, 2.1rem) !important;
    text-shadow: 2px 2px 0 var(--coral);
  }

  .site-footer p,
  .footer-letter :global(p) {
    margin: 0 0 0.7em;
  }

  .footer-club {
    font-weight: 600;
  }

  .footer-letter {
    line-height: 1.65;
  }

  .cheer {
    width: fit-content;
    margin: 4px 0 2px !important;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 4vw, 1.8rem);
    color: var(--yellow);
    text-shadow: 2px 2px 0 var(--coral);
  }

  .credit {
    opacity: 0.8;
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .names li {
    padding: 2px 14px;
    font-weight: 600;
    color: var(--ink);
    background: var(--c);
    border: 2px solid var(--sand);
    border-radius: 999px;
  }

  .footer-links {
    margin-top: 28px;
    padding-top: 16px;
    font-size: 0.9rem;
    text-align: center;
    border-top: 1px solid color-mix(in srgb, var(--sand) 20%, transparent);
  }

  .footer-links a {
    color: var(--sand);
    opacity: 0.8;
  }

  .footer-links a:hover {
    opacity: 1;
  }

  @media (max-width: 480px) {
    .brand-tag {
      display: none;
    }
  }
</style>
