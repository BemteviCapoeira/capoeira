---
import '@fontsource-variable/rubik';
import '@fontsource-variable/fredoka';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/print.css';
import { Image } from 'astro:assets';
import bemtevi from '../assets/bemtevi.jpg';
import LanguageMenu from '../components/LanguageMenu.astro';
import Ribbons from '../components/Ribbons.astro';
import { DEFAULT_LOCALE, LANGUAGES, LOCALES, localePath, UI, type Locale } from '../data/i18n';
import { SITE_TEXT } from '../data/site';

interface Props {
  locale: Locale;
  /**
   * This page's address relative to the site root, the same in every language ('' for home, 'about/', 'songs/x/').
   * Pages without one (the English-only "Add a song" pages, the 404 page) aren't translated: the language menu
   * then links to each language's home page.
   */
  path?: string;
  /** Which header tab to highlight. */
  section?: 'songs' | 'about';
  title?: string;
  description?: string;
  /** Absolute path of a social-preview image. */
  image?: string;
  /** Keep the page out of search engines. */
  noindex?: boolean;
}

const { locale, path, section, title, image, noindex = false } = Astro.props;
const t = UI[locale];
const site = SITE_TEXT[locale];
const description = Astro.props.description ?? site.description;
const fullTitle = title ? `${title} · ${site.shortTitle}` : site.title;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site).toString() : new URL(`${base}icon-512.png`, Astro.site).toString();
const translations = Object.fromEntries(LOCALES.map((l) => [l, localePath(l, path ?? '')])) as Record<Locale, string>;
const tabs = [
  { id: 'songs', label: t.nav.songs, href: localePath(locale), path: '' },
  { id: 'about', label: t.nav.about, href: localePath(locale, 'about/'), path: 'about/' },
] as const;
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      path !== undefined && (
        <>
          {LOCALES.map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(translations[l], Astro.site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(translations[DEFAULT_LOCALE], Astro.site)} />
          {/* Someone who picked a language in the menu lands in it when they come back from outside the site
              (a bookmark, the home-screen app, a shared link). Browsing within the site never redirects. */}
          <script is:inline define:vars={{ locale, translations }}>
            try {
              const wanted = localStorage.getItem('lang');
              if (wanted && wanted !== locale && translations[wanted] && !document.referrer.startsWith(location.origin)) {
                location.replace(translations[wanted] + location.search + location.hash);
              }
            } catch {}
          </script>
        </>
      )
    }
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.json`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#87ceeb" />
    <meta name="apple-mobile-web-app-title" content={site.shortTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={LANGUAGES[locale].ogLocale} />
    {
      path !== undefined &&
        LOCALES.filter((l) => l !== locale).map((l) => (
          <meta property="og:locale:alternate" content={LANGUAGES[l].ogLocale} />
        ))
    }
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body data-base={base}>
    <div class="site">
      <a class="skip-link" href="#main">{t.skipLink}</a>
      <header class="site-header">
        <div class="wrap header-row">
          <a class="brand" href={localePath(locale)}>
            <Image src={bemtevi} alt="" width={112} class="brand-emblem" loading="eager" />
            <span class="brand-text">
              <span class="brand-name">{site.shortTitle}</span>
              <span class="brand-tag" lang="pt-BR">Abadá-Capoeira</span>
            </span>
          </a>
          <nav class="tabs" aria-label={t.nav.label}>
            {
              tabs.map((tab) => (
                <a
                  class="tab"
                  href={tab.href}
                  aria-current={section === tab.id ? (path === tab.path ? 'page' : 'true') : undefined}
                >
                  {tab.label}
                </a>
              ))
            }
          </nav>
          <LanguageMenu locale={locale} links={translations} samePage={path !== undefined} />
        </div>
      </header>
      <Ribbons />
      <main id="main" class="wrap">
        <slot />
      </main>
    </div>
    <slot name="print" />
  </body>
</html>

<script>
  import { initImageFallback } from '../scripts/image-fallback';
  initImageFallback();
</script>

<style>
  .site {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .site-header {
    background: var(--sky-soft);
    border-bottom: var(--border);
  }

  .header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    padding-block: 10px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-inline-end: auto;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-emblem {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: var(--border);
    object-fit: cover;
    object-position: 50% 30%;
    box-shadow: var(--shadow-sm);
    transition: rotate 0.3s ease;
  }

  .brand:hover .brand-emblem {
    rotate: -12deg;
  }

  .brand-text {
    display: grid;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.4rem;
  }

  .brand-tag {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* Songs | About: a segmented control */
  .tabs {
    display: flex;
    gap: 4px;
    padding: 4px;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    border-radius: 999px;
  }

  .tab {
    padding: 4px 16px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border: var(--border-w) solid transparent;
    border-radius: 999px;
    transition: background-color 0.12s ease;
  }

  .tab:hover {
    background: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  .tab[aria-current] {
    background: var(--paper);
    border-color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  main {
    flex: 1;
    padding-block: 20px 72px;
  }

  /* phones: brand and language menu on the first row, the tabs on their own row below */
  @media (max-width: 640px) {
    .tabs {
      order: 1;
      flex: 1 0 100%;
    }

    .tab {
      flex: 1;
      text-align: center;
    }

    .brand-emblem {
      width: 44px;
      height: 44px;
    }

    .brand-name {
      font-size: 1.2rem;
    }
  }
</style>
