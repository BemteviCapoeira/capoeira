---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import bemtevi from '../../assets/bemtevi.jpg';
import pandeiro from '../../assets/pandeiro.jpg';
import { Content as WelcomeHe } from '../../content/welcome/he.md';
import { Content as WelcomeEn } from '../../content/welcome/en.md';
import { LANGUAGES, localeParams, UI, type Locale } from '../../data/i18n';
import { SITE, SITE_TEXT } from '../../data/site';

export function getStaticPaths() {
  return localeParams().map(({ params, locale }) => ({ params, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale].about;
const site = SITE_TEXT[locale];
const dir = LANGUAGES[locale].dir;
const Welcome = locale === 'he' ? WelcomeHe : WelcomeEn;
const NAME_COLORS = ['coral', 'turquoise', 'yellow', 'pink', 'lime', 'sky'];
---

<Base locale={locale} path="about/" section="about" title={t.title}>
  <div class="about" dir={dir}>
    <header class="card hero">
      <div class="hero-copy">
        <h1>{site.title}</h1>
        <p class="club">{site.club}</p>
        <p>{site.group}</p>
      </div>
      <Image
        src={bemtevi}
        alt={locale === 'he' ? 'ציפור בנטווי צהובה' : 'A yellow bem-te-vi bird'}
        width={360}
        class="hero-photo"
        loading="eager"
      />
    </header>

    <section class="card letter" style={`--pandeiro-icon: url('${pandeiro.src}')`}>
      <Welcome />
      <p class="cheer" lang="pt-BR" dir="ltr">{SITE.cheer}</p>
    </section>

    <section class="card thanks" aria-labelledby="thanks">
      <h2 id="thanks">{t.thanks}</h2>
      <p>{site.thanksIntro}</p>
      <ul class="names">
        {site.thanks.map((name, i) => <li style={`--c:var(--${NAME_COLORS[i % NAME_COLORS.length]})`}>{name}</li>)}
      </ul>
      <p class="site-thanks">
        {site.siteThanksIntro}
        {site.siteThanks.map((name) => <strong class="name-pill" style="--c:var(--coral)">{name}</strong>)}
        {site.siteThanksOutro}
      </p>
      <p class="site-thanks site-credit">
        {site.credit}<strong class="name-pill">Bem-te-vi</strong>
      </p>
    </section>

    <p class="add-song">
      <a class="btn" href={`${import.meta.env.BASE_URL}new-song/`}>{t.addSong}</a>
    </p>
  </div>
</Base>

<style>
  .about {
    display: grid;
    gap: 28px;
    max-width: 820px;
    margin-inline: auto;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(14px, 4vw, 28px);
    color: var(--sand);
    background: var(--ink);
    box-shadow: 6px 6px 0 var(--coral);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-photo {
    display: block;
    width: clamp(120px, 22vw, 180px);
    height: auto;
    border: 2px solid var(--sand);
    border-radius: var(--radius-sm);
    box-shadow: 3px 3px 0 var(--yellow);
  }

  h1 {
    margin-bottom: 12px;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    color: var(--yellow);
    text-shadow: 3px 3px 0 var(--coral);
  }

  .hero p {
    margin: 0;
  }

  .club {
    font-weight: 600;
  }

  .letter {
    line-height: 1.7;
  }

  .letter :global(ul) {
    display: grid;
    gap: 6px;
    margin: 0 0 0.8em;
    padding: 0;
    list-style: none;
  }

  .letter :global(li) {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }

  .letter :global(li)::before {
    content: '';
    flex: 0 0 2.3958em;
    width: 2.3958em;
    height: 1.331em;
    background: var(--pandeiro-icon) center / contain no-repeat;
  }

  .letter :global(p) {
    margin: 0 0 0.8em;
  }

  .cheer {
    width: fit-content;
    margin: 8px auto 4px !important;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 4vw, 1.9rem);
    color: var(--ink);
    text-shadow: 2px 2px 0 var(--yellow);
  }

  .thanks h2 {
    margin-bottom: 10px;
    font-size: 1.6rem;
  }

  .thanks > p,
  .site-thanks {
    font-size: 1.125rem;
  }

  @media (max-width: 640px) {
    .thanks > p,
    .site-thanks {
      font-size: 1rem;
    }
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .names li {
    display: flex;
    align-items: center;
    min-height: 36px;
    padding: 2px 14px;
    font-weight: 600;
    background: var(--c);
    border: 2px solid var(--ink);
    border-radius: 999px;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .site-thanks {
    margin: 48px 0 0;
  }

  .site-credit {
    margin-top: 48px;
  }

  .site-thanks .name-pill {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    margin-inline: 1ch;
    padding: 2px 18px;
    font-weight: 600;
    background: var(--green);
    border: 2px solid var(--ink);
    border-radius: 999px;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .site-credit .name-pill {
    background: var(--lavender);
  }

  .add-song {
    margin: 0;
  }
</style>
