---
import Base from '../layouts/Base.astro';
import BerimbauArt from '../components/BerimbauArt.astro';
---

<Base title="הדף לא נמצא">
  <section class="card lost" dir="rtl">
    <div class="art"><BerimbauArt /></div>
    <h1>אופס! הדף הזה לא נמצא</h1>
    <p>אולי השיר עבר למקום אחר. בואו נחזור לרודה:</p>
    <a class="btn" href={`${import.meta.env.BASE_URL}#songs`}>לכל השירים</a>
  </section>
</Base>

<style>
  .lost {
    max-width: 560px;
    margin: 24px auto;
    text-align: center;
  }

  .art {
    width: 180px;
    margin: 0 auto 16px;
    border: var(--border);
    border-radius: 50%;
    overflow: hidden;
  }

  h1 {
    margin-bottom: 8px;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
  }
</style>
