---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import atabaque from '../../assets/atabaque.jpg';
import bemtevi from '../../assets/bemtevi.jpg';
import BerimbauArt from '../../components/BerimbauArt.astro';
import { localePath } from '../../data/i18n';
import { SITE } from '../../data/site';
import '../../styles/forms.css';

const repoUrl = `https://github.com/${SITE.repo.owner}/${SITE.repo.name}`;
---

<Base locale="en" title="Connect to GitHub" description="Connect a GitHub token to add songs." noindex>
  <div class="form-page narrow">
    <header class="intro">
      <h1 class="section-title">Add a song</h1>
      <div class="intro-with-art">
        <div class="intro-copy">
          <aside class="access-note" aria-labelledby="access-title">
            <h2 id="access-title">Only Graduados can add songs</h2>
            <p>To submit a song, you need a TOKEN with write access to this repository.</p>
            <p>If you'd like to suggest a song, please contact the site administrator.</p>
          </aside>
          <p>
            New songs are sent to GitHub as pull requests. To send one you need a GitHub account with write access to{' '}
            <a href={repoUrl}>the repository</a>, and a personal access token. You only need to do this once per device.
          </p>
        </div>
        <Image src={atabaque} alt="Atabaque drum" width={214} class="intro-art" loading="eager" />
      </div>
    </header>

    <div class="steps">
      <form class="card step" aria-labelledby="paste" data-connect-form novalidate>
        <h2 id="paste">Paste your GitHub token here</h2>
        <div class="row">
          <div class="field grow">
            <label for="token">Token</label>
            <input
              id="token"
              name="token"
              type="password"
              autocomplete="off"
              spellcheck="false"
              placeholder="github_pat_…"
              required
            />
          </div>
          <button type="submit" class="btn">Connect</button>
        </div>
        <label class="check"><input type="checkbox" name="remember" /> Remember the token on this device</label>
        <p class="fine">The token stays in this browser and is only ever sent to GitHub.</p>
        <div class="outcome">
          <div class="broken-art" data-broken hidden><BerimbauArt broken /></div>
          <p class="status" data-status role="status"></p>
        </div>
      </form>
    </div>

    <div class="page-actions">
      <a class="btn" href={localePath('en')}>
        <Image src={bemtevi} alt="" width={28} class="bird-icon" loading="lazy" />
        Back to Songs
      </a>
      <a class="btn" href={localePath('en', 'about/')}>Back to About</a>
    </div>
  </div>
</Base>

<script>
  import { initConnect } from '../../scripts/connect';
  initConnect();
</script>

<style>
  .intro-with-art {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(16px, 4vw, 32px);
  }

  .intro-copy {
    min-width: 0;
  }

  .intro-copy h2 {
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
  }

  .access-note {
    margin-bottom: 16px;
    padding: 14px 18px;
    font-weight: 600;
    background: color-mix(in srgb, var(--yellow) 25%, var(--paper));
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .access-note p {
    margin-bottom: 8px;
    font-weight: 600;
  }

  .access-note p:last-child {
    margin-bottom: 0;
  }

  .intro-art {
    display: block;
    width: clamp(124px, 23vw, 177px);
    height: auto;
    padding: 6px;
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .steps {
    display: grid;
    gap: 28px;
  }

  .page-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  .page-actions .btn {
    min-height: 48px;
    gap: 8px;
  }

  .bird-icon {
    flex: none;
    width: 28px;
    height: 28px;
    border: var(--border);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
    object-fit: cover;
    object-position: 50% 30%;
  }

  .outcome {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
  }

  .outcome .status {
    flex: 1;
    margin: 0;
  }

  .broken-art {
    flex: none;
    width: 96px;
    border: var(--border);
    border-radius: 50%;
    overflow: hidden;
  }

  .broken-art[hidden] {
    display: none;
  }

  .broken-art :global(.berimbau-art) {
    aspect-ratio: 1;
  }

  @media (max-width: 420px) {
    .intro-with-art {
      grid-template-columns: minmax(0, 1fr) 124px;
      gap: 12px;
    }

    .intro-art {
      width: 124px;
    }
  }
</style>
